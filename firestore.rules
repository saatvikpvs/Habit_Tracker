rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's habit-ledger data lives at /users/{uid}.
    // Only the signed-in owner of that uid may read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy pre-multi-user data (the old shared document every account used to read
    // and write). Read-only, kept just long enough for the one-time client-side
    // migration in public/index.html to copy it into users/{uid}. Delete this block
    // (and the legacy document) once that migration has run.
    match /habitLedger/data {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
